#!/usr/bin/env python

"""Export a strict SRT plus a manifest, and restore paragraph breaks later."""

import io
import json
import logging
import sys

import srt
import srt_tools.utils

log = logging.getLogger(__name__)

# Exit code when --on-conflict skip found boundaries that could not be
# restored. The restored SRT is still written. Distinct from a hard failure
# (raise mode, exit code 4) so callers can tell "output produced with
# conflicts" apart from "no output".
EXIT_CONFLICTS = 3
EXIT_HARD_CONFLICT = 4


def parse_args():
    examples = {
        "Export a strict SRT and its paragraph manifest": (
            "srt paragraphed export -i interview.srt "
            "-o interview.strict.srt --manifest interview.manifest.json"
        ),
        "Restore paragraphs into an edited strict SRT": (
            "srt paragraphed restore -i interview.strict.edited.srt "
            "--manifest interview.manifest.json -o interview.restored.srt"
        ),
    }

    parser = srt_tools.utils.basic_parser(
        description=__doc__, examples=examples, hide_no_strict=True
    )
    parser.add_argument(
        "mode",
        choices=("export", "restore"),
        help="export a strict SRT with a manifest, or restore paragraphs "
        "from an edited strict SRT and its manifest",
    )
    parser.add_argument(
        "--manifest",
        "-m",
        metavar="FILE",
        required=True,
        help=(
            "export: where to write the JSON rewrite record; "
            "restore: the JSON rewrite record produced at export time"
        ),
    )
    parser.add_argument(
        "--on-conflict",
        choices=("raise", "skip"),
        default="raise",
        help=(
            "restore only: what to do when an original paragraph boundary "
            "cannot be located — raise an error (default) or keep that "
            "subtitle strict and report the conflict"
        ),
    )

    return parser.parse_args()


def write_manifest(manifest, path):
    with io.open(path, "w", encoding="utf-8", newline="\n") as manifest_f:
        json.dump(manifest, manifest_f, ensure_ascii=False, indent=2)
        manifest_f.write("\n")


def read_manifest(path, encoding):
    with io.open(path, "r", encoding=encoding) as manifest_f:
        return json.load(manifest_f)


def write_output(args, output):
    try:
        args.output.write(output)
    except (UnicodeEncodeError, TypeError):  # Python 2 fallback
        args.output.write(output.encode(args.encoding))
    # We may exit with a non-zero conflict status below, which would bypass
    # normal interpreter shutdown flushing, so flush explicitly.
    args.output.flush()


def main():
    args = parse_args()
    logging.basicConfig(level=args.log_level)
    srt_tools.utils.set_basic_args(args)

    conflicts = None

    if args.mode == "export":
        strict_srt, manifest = srt.compose_strict_with_manifest(args.input)
        write_manifest(manifest, args.manifest)
        output = strict_srt
    else:
        manifest = read_manifest(args.manifest, args.encoding or "utf-8-sig")
        if args.on_conflict == "raise":
            try:
                output = srt.restore_paragraphs(args.input, manifest)
            except srt.ParagraphRestoreError as thrown:
                log.critical("%s", thrown)
                sys.exit(EXIT_HARD_CONFLICT)
        else:
            output, conflicts = srt.restore_paragraphs(
                args.input, manifest, on_conflict="skip"
            )
            for conflict in conflicts:
                log.warning("%s", conflict)

    write_output(args, output)

    if conflicts:
        log.critical(
            "%d subtitle(s) could not have their paragraphs restored",
            len(conflicts),
        )
        sys.exit(EXIT_CONFLICTS)


if __name__ == "__main__":  # pragma: no cover
    main()
