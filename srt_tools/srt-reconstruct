#!/usr/bin/env python

"""Reconstruct spoken increments from a scrolling caption SRT."""

import datetime
import logging

import srt
import srt_tools.utils

log = logging.getLogger(__name__)


def parse_args():
    examples = {
        "Reconstruct increments from a rolling caption file": (
            "srt reconstruct -i rolling.srt"
        ),
        "Also emit a machine-readable revision ledger": (
            "srt reconstruct -i rolling.srt --json ledger.json"
        ),
        "Mark the last utterance final (the file is known to be complete)": (
            "srt reconstruct -i rolling.srt --finalize-last"
        ),
    }

    parser = srt_tools.utils.basic_parser(
        description=__doc__,
        examples=examples,
        hide_no_strict=True,
    )
    parser.add_argument(
        "--json",
        metavar="FILE",
        help="write the revision ledger as JSON to FILE (use - for stdout)",
    )
    parser.add_argument(
        "--marker",
        metavar="TEXT",
        default=srt.PROVISIONAL_MARKER,
        help="suffix appended to utterances that are not yet final "
        "(default: %(default)r, pass an empty string to disable)",
    )
    parser.add_argument(
        "--ms",
        metavar="MILLISECONDS",
        default=srt.DEFAULT_MAX_GAP,
        type=lambda ms: datetime.timedelta(milliseconds=int(ms)),
        help="maximum gap between snapshots that still counts as continuous "
        "(default: %(default)s)",
    )
    parser.add_argument(
        "--min-shared",
        metavar="CHARS",
        default=srt.DEFAULT_MIN_SHARED,
        type=int,
        help="minimum shared anchor length in significant characters "
        "(default: %(default)s)",
    )
    parser.add_argument(
        "--min-coverage",
        metavar="FRACTION",
        default=srt.DEFAULT_MIN_COVERAGE,
        type=float,
        help="minimum shared fraction of the shorter snapshot for a "
        "correction (default: %(default)s)",
    )
    parser.add_argument(
        "--finalize-last",
        action="store_true",
        help="mark the last utterance final instead of provisional",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    logging.basicConfig(level=args.log_level)
    srt_tools.utils.set_basic_args(args)

    result = srt.reconstruct_increments(
        args.input,
        max_gap=args.ms,
        min_shared=args.min_shared,
        min_coverage=args.min_coverage,
        finalize_last=args.finalize_last,
    )

    output = result.to_srt(provisional_marker=args.marker or None)

    if args.json and args.json == "-":
        args.output.write(result.to_json())
        return

    try:
        args.output.write(output)
    except (UnicodeEncodeError, TypeError):  # Python 2 fallback
        args.output.write(output.encode(args.encoding))

    if args.json:
        with open(args.json, "w") as json_f:
            json_f.write(result.to_json())


if __name__ == "__main__":  # pragma: no cover
    main()
