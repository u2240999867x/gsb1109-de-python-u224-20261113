{
    "alphabet": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
    "min_length": 4,
    "max_length": 8,
    "enumerate_cap": 300000,
    "sample_budget": 60,
    "sample_seed": 0,
    "rules": [
        {"name": "part_no", "pattern": "PN[A-Z0-9]{4,8}", "priority": 10, "label": "料号"},
        {"name": "model", "pattern": "M[A-Z]{2,5}[0-9]{1,3}", "priority": 20, "label": "型号"},
        {"name": "batch", "pattern": "B[A-Z0-9]{3,6}", "priority": 30, "label": "批号"},
        {"name": "lot_new", "pattern": "[A-Z]{2}[0-9]{4,6}", "priority": 40, "label": "批号(新规则)"}
    ]
}
